{
  "name": "sql-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Local SQL learning playground: lessons, join visualizer, editor and exercises against a Dockerized PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:destroy": "docker compose down -v",
    "seed:generate": "node scripts/generate-seed.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
